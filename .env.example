# Server-only. Đặt trong Vercel → Settings → Environment Variables (hoặc .env.local khi chạy máy).
# Không dùng tiền tố NEXT_PUBLIC_ cho các biến này.

# Origin HTTPS của Nova Business backend, không có đường dẫn. Ví dụ: https://<nova-backend-host>
NOVA_API_URL=

# Chuỗi ngẫu nhiên tối thiểu 32 byte để ký cookie phiên Replyn.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
REPLYN_SESSION_SECRET=

# Secret server-to-server cho đăng nhập bằng mã QR, trùng giá trị REPLYN_QR_CLIENT_SECRET của Nova backend.
# Tối thiểu 32 ký tự ngẫu nhiên. Bỏ trống thì mã QR báo chưa khả dụng; Nova ID vẫn chạy bình thường.
REPLYN_QR_CLIENT_SECRET=
